{
  "$schema": "https://www.getbifrost.ai/schema",
  "config_store": { "enabled": false },
  "logs_store": { "enabled": false },
  "providers": {
    "groq": {
      "keys": [
        {
          "name": "groq-main",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 60,
        "max_retries": 1
      }
    }
  }
}
